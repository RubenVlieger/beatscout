# BeatScout Environment Configuration
# Copy this file to .env and fill in your values

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-key-min-32-characters
NEXTAUTH_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters

# SoundCloud OAuth
# Get these from: https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
SOUNDCLOUD_CLIENT_SECRET=your-soundcloud-client-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beatscout

# AWS (Optional - for future SQS integration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Development
DEBUG=true

# DashScope API (Qwen3-Omni Audio Analysis)
# Get your API key from: https://bailian.console.aliyun.com/?tab=api-key
# Beijing region has 1M free tokens (valid for 90 days after activation)
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
